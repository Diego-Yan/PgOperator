<UserControl x:Class="PgOperator.App.Views.SqlQueryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="2*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Content="← 返回" Click="BackButton_Click" />
            <TextBlock Text="SQL 查询器" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="执行 (F5)" Margin="12,0,4,0"
                    Command="{Binding ExecuteQueryCommand}" />
            <Button Content="EXPLAIN ANALYZE" Margin="4,0"
                    Command="{Binding ExplainCurrentCommand}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
        </DockPanel>

        <TextBox Grid.Row="1" Text="{Binding SqlText, }"
                 AcceptsReturn="True" FontFamily="Consolas" FontSize="14"
                
                 Margin="0,8" Padding="8"
                 Background="{DynamicResource MaterialDesignCardBackground}"
                 Foreground="{DynamicResource MaterialDesignBody}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
            <TextBlock Text="{Binding ExecutionTime}" Margin="0,0,16,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="{Binding RowCount, StringFormat='{}{0} 行'}" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <TabControl Grid.Row="3">
            <TabItem Header="查询结果">
                <TextBox Text="{Binding QueryResult}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                        
                         Padding="8"
                         Background="{DynamicResource MaterialDesignCardBackground}"
                         Foreground="{DynamicResource MaterialDesignBody}" />
            </TabItem>
            <TabItem Header="执行计划">
                <TextBox Text="{Binding ExplainPlan}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                        
                         Padding="8"
                         Background="{DynamicResource MaterialDesignCardBackground}"
                         Foreground="{DynamicResource MaterialDesignBody}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
