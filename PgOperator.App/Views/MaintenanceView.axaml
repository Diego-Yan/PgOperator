<UserControl x:Class="PgOperator.App.Views.MaintenanceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- [REVIEW-FIX] 统一页头 + 状态配色 -->
        <DockPanel>
            <Button Content="← 返回" Click="BackButton_Click"/>
            <TextBlock Text="日常维护" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{Binding Status, Converter={StaticResource StatusTextToColorConverter}}"
                       FontWeight="SemiBold" FontSize="12"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8">
            <TextBlock Text="操作类型" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
            <ComboBox ItemsSource="{Binding VacuumTypes}" SelectedIndex="{Binding VacuumType}" Margin="0,0,0,8"/>
            <TextBlock Text="目标表 (空=全部)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
            <TextBox Text="{Binding TargetTable}" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button Content="执行VACUUM" Command="{Binding ExecuteVacuumCommand}" Margin="0,0,8,0"/>
                <Button Content="执行REINDEX" Command="{Binding ExecuteReindexCommand}" Margin="0,0,8,0"/>
                <Button Content="执行ANALYZE" Command="{Binding ExecuteAnalyzeCommand}" Margin="0,0,8,0"/>
                <Button Content="检查表膨胀" Command="{Binding CheckBloatCommand}"/>
            </WrapPanel>
        </StackPanel>
        <TextBox Grid.Row="2" Text="{Binding Output}" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                 Margin="0,8" Padding="8"
                 Background="{DynamicResource MaterialDesignCardBackground}"/>
    </Grid>
</UserControl>
