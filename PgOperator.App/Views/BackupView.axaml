<UserControl x:Class="PgOperator.App.Views.BackupView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- [REVIEW-FIX] 统一页头 + 状态配色 -->
        <DockPanel Margin="0,0,0,8">
            <Button Content="← 返回" Click="BackButton_Click"/>
            <TextBlock Text="备份管理" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusTextToColorConverter}}"
                       FontWeight="SemiBold" FontSize="12"/>
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="执行备份">
                <ScrollViewer>
                    <StackPanel Width="500" Margin="0,8">
                        <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="磁盘空间检查" FontWeight="SemiBold"/>
                                    <Button Content="检查" Height="28" FontSize="11"
                                            Click="CheckDiskSpace_Click" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DiskSpaceInfo}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="备份类型" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding BackupTypes}" SelectedIndex="{Binding BackupTypeIndex}" Margin="0,0,0,8"/>
                        <TextBlock Text="备份格式" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex}" Margin="0,0,0,8"
                                  IsVisible="{Binding BackupTypeIndex, Converter={StaticResource BoolToZeroVisibilityConverter}}"/>
                        <TextBlock Text="数据库名" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedDatabase}" Margin="0,0,0,8"/>
                        <TextBlock Text="远程备份路径" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding RemotePath}" Margin="0,0,0,8"/>
                        <TextBlock Text="保留天数" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding RetentionDays}" Margin="0,0,0,12"/>

                        <Button Content="开始备份" Height="40"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToInverseConverter}}" Click="RunBackup_Click"/>
                        <TextBlock Text="{Binding LastBackupInfo}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" FontWeight="SemiBold"/>
                        <Separator Margin="0,16"/>
                        <Button Content="检查PITR配置" Click="CheckPitr_Click"/>
                        <TextBlock Text="Sudo密码(修复用)" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,2"/>
                        <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SudoPassword, }" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="修复物理备份环境" Click="FixReplication_Click" Height="28" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="备份管理">
                <Grid Margin="0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="刷新列表" Command="{Binding RefreshFileListCommand}" Margin="0,0,8,0"/>
                        <Button Content="校验选中" Command="{Binding ValidateSelectedCommand}" Margin="0,0,8,0"/>
                        <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                        <TextBlock Text="{Binding TotalBackupSize, StringFormat='总计: {0}'}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="清理" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding CleanupDays}" Width="40" Margin="0,0,4,0" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="天前的备份" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="执行清理" Command="{Binding CleanupOldBackupsCommand}" Height="28" FontSize="12"/>
                    </DockPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding BackupFiles}" AutoGenerateColumns="False" SelectedItem="{Binding SelectedFile}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeFormatted}" Width="Auto"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding LastModified}" Width="Auto"/>
                            <DataGridTextColumn Header="类型" Width="Auto">
                                <DataGridTextColumn.Binding><Binding Path="IsLogical" Converter="{StaticResource BoolToBackupTypeConverter}"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
