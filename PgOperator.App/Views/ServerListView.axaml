<UserControl x:Class="PgOperator.App.Views.ServerListView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [REVIEW-FIX] 统一页头样式 -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="服务器管理" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button x:Name="AddButton" Content="+" Width="36" Height="36" Margin="12,0,0,0"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    ToolTip="添加服务器" Click="AddButton_Click" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="16,0,0,0" />
        </DockPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- [REVIEW-FIX] 服务器卡片：左侧色条标识状态（绿=可用，红=不可用） -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            CornerRadius="6" Padding="16,12" Margin="0,0,0,8"
                            BorderBrush="{Binding IsAvailable, Converter={StaticResource BoolToStatusColorConverter}}"
                            BorderThickness="3,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"
                                    Background="{Binding IsAvailable, Converter={StaticResource BoolToStatusColorConverter}}" />

                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    <Run Text="{Binding Username, Mode=OneWay}" /><Run Text="@" />
                                    <Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding OsInfo}" FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="测试连接" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="删除" Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="30" FontSize="11" Margin="0,0,4,0"
                                        Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                        Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="▶ 进入" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" FontSize="12" FontWeight="Bold" MinWidth="70"
                                        Click="EnterButton_Click" Tag="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>
