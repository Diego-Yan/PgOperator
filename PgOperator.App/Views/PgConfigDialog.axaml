<Window x:Class="PgOperator.App.Views.PgConfigDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置PG数据库密码" Width="460" Height="380"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="28,24,28,16">

        <!-- Form content -->
        <StackPanel Grid.Row="0" Spacing="10">
            <Border Background="#F5F5F5" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="PostgreSQL 数据库连接" FontWeight="Bold" FontSize="14" />

                    <!-- PG Host & Port -->
                    <TextBlock Text="PG主机" FontWeight="SemiBold" FontSize="12" />
                    <Grid ColumnDefinitions="2*,8,*">
                        <TextBox Grid.Column="0" x:Name="PgHostBox" Text="localhost" />
                        <TextBox Grid.Column="2" x:Name="PgPortBox" Text="5432" />
                    </Grid>

                    <!-- Database -->
                    <TextBlock Text="数据库名" FontWeight="SemiBold" FontSize="12" />
                    <TextBox x:Name="DatabaseBox" Text="postgres" />

                    <!-- Username -->
                    <TextBlock Text="PG用户名" FontWeight="SemiBold" FontSize="12" />
                    <TextBox x:Name="UsernameBox" Text="postgres" />

                    <!-- Password -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="PG密码" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="*必填" Foreground="#C62828" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="PasswordBox" PasswordChar="*" PlaceholderText="输入数据库密码" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="#C62828"
                       TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <!-- Bottom buttons — separated by divider -->
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="0,16,0,0" Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <Button Content="保存" Height="40" IsDefault="True"
                        Background="#1E88E5" Foreground="White" FontSize="14" FontWeight="SemiBold"
                        Click="SaveButton_Click" />
                <Button Content="取消" Height="36" IsCancel="True" Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
