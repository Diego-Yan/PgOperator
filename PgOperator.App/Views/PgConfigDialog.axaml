<Window x:Class="PgOperator.App.Views.PgConfigDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        Title="配置PG数据库密码" Width="440" Height="320"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="配置 PostgreSQL 数据库连接" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PG Host -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="PG主机" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,10"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="PgHostBox" Text="localhost"/>
                    <TextBox Grid.Column="2" x:Name="PgPortBox" Text="5432"/>
                </Grid>

                <!-- Database -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库名" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabaseBox" Text="postgres" Margin="0,0,0,10"/>

                <!-- Username -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="PG用户名" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UsernameBox" Text="postgres" Margin="0,0,0,10"/>

                <!-- Password -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="PG密码" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,0"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="PasswordBox" Width="200" Margin="0,0,8,0"/>
                    <TextBlock Text="*必填" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                               VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                       TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80"
                    IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="保存" Width="80"
                    Margin="8,0,0,0" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
