<UserControl x:Class="PgOperator.App.Views.DeployView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [REVIEW-FIX] 统一页头 + 状态配色 -->
        <DockPanel Margin="0,0,0,12">
            <Button Content="← 返回" Click="BackButton_Click"/>
            <TextBlock Text="PG 部署安装" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{Binding Status, Converter={StaticResource StatusTextToColorConverter}}"
                       FontWeight="SemiBold" FontSize="12"/>
        </DockPanel>

        <!-- Configuration Form -->
        <GroupBox Grid.Row="1" Header="部署配置" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PG Version -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="PG 版本" VerticalAlignment="Center"
                           Width="120" FontWeight="SemiBold" Margin="0,0,12,8"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PgVersions}"
                          SelectedItem="{Binding PgVersion}" Width="100" Margin="0,0,0,8"/>

                <!-- Port -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="监听端口" VerticalAlignment="Center"
                           Width="120" FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Width="100" Margin="0,0,0,8"/>

                <!-- Listen Address -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="监听地址" VerticalAlignment="Center"
                           Width="120" FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ListenAddress}" Width="200" Margin="0,0,0,8"/>

                <!-- PG Password -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="PG管理员密码" VerticalAlignment="Center"
                           Width="120" FontWeight="SemiBold" Margin="0,0,12,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PgPassword}" Width="200" Margin="0,0,0,8"/>

                <!-- Sudo Password -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Sudo密码" VerticalAlignment="Center"
                           Width="120" FontWeight="SemiBold" Margin="0,0,12,0"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding SudoPassword}" Width="200" Margin="0,0,8,0"/>
                    <TextBlock Text="*必填" Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                               VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <WrapPanel Grid.Row="2" Margin="0,4,0,8">
            <Button Content="🔍 环境检测" Click="CheckEnv_Click"
                   
                    Height="40" Width="130" FontSize="14" Margin="0,0,8,0"/>
            <Button Content="📦 一键安装" Click="InstallPg_Click"
                   
                    Height="40" Width="130" FontSize="14" Margin="0,0,8,0"/>
            <TextBlock Text="先检测 → 确认无误 → 再安装" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" Margin="8,0,0,0"/>
        </WrapPanel>

        <!-- Output Console -->
        <TextBox Grid.Row="3" Text="{Binding Output}" FontFamily="Consolas" FontSize="13"
                 IsReadOnly="True"
                 Padding="12" BorderThickness="1"
                 BorderBrush="{DynamicResource MaterialDesignDivider}"
                 Background="{DynamicResource MaterialDesignCardBackground}"
                 Foreground="{DynamicResource MaterialDesignBody}"/>
    </Grid>
</UserControl>
