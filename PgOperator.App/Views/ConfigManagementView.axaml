<UserControl x:Class="PgOperator.App.Views.ConfigManagementView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [REVIEW-FIX] 统一页头 -->
        <DockPanel>
            <Button Content="← 返回" Style="{StaticResource MaterialDesignFlatButton}" Click="BackButton_Click" />
            <TextBlock Text="配置管理" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="加载配置" Command="{Binding LoadConfigCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="12,0,4,0" />
            <Button Content="保存" Command="{Binding SaveConfigCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0" />
            <Button Content="撤销" Command="{Binding RevertConfigCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="4,0" />
            <Button Content="Reload PG" Command="{Binding ReloadConfigCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="4,0" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <TextBlock Text="*" Foreground="Orange" FontSize="20" VerticalAlignment="Center"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
        </DockPanel>

        <!-- Tab Selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
            <Button Content="postgresql.conf" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding LoadConfigCommand}" />
            <Button Content="pg_hba.conf" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding LoadHbaCommand}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding ConfigFilePath2}" FontSize="11" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </StackPanel>

        <!-- Config Editor -->
        <TabControl Grid.Row="2">
            <TabItem Header="postgresql.conf" IsSelected="True">
                <TextBox Text="{Binding ConfigContent, }"
                         AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="8" TextChanged="ConfigText_Changed"
                         Background="{DynamicResource MaterialDesignCardBackground}" />
            </TabItem>
            <TabItem Header="pg_hba.conf">
                <TextBox Text="{Binding HbaContent, }"
                         AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="8"
                         Background="{DynamicResource MaterialDesignCardBackground}" />
            </TabItem>
        </TabControl>

        <!-- Key Parameters Quick View -->
        <Expander Grid.Row="3" Header="关键参数速览" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding KeyParameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </Grid>
</UserControl>
