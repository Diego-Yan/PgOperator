<UserControl x:Class="PgOperator.App.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12" Width="480">
        <StackPanel>
            <!-- [REVIEW-FIX] 统一页头 -->
            <DockPanel Margin="0,0,0,16">
                <Button Content="← 返回" Style="{StaticResource MaterialDesignFlatButton}" Click="BackButton_Click"/>
                <TextBlock Text="AI 分析设置" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
            </DockPanel>
            <ComboBox materialDesign:HintAssist.Hint="AI提供商" ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Margin="0,0,0,8"/>
            <TextBox materialDesign:HintAssist.Hint="API Key" Text="{Binding ApiKey}" Margin="0,0,0,8"/>
            <TextBox materialDesign:HintAssist.Hint="API Endpoint (留空用默认)" Text="{Binding ApiEndpoint}" Margin="0,0,0,8"/>
            <TextBox materialDesign:HintAssist.Hint="模型 (留空用默认)" Text="{Binding Model}" Margin="0,0,0,8"/>
            <ComboBox materialDesign:HintAssist.Hint="分析偏好" ItemsSource="{Binding Preferences}" SelectedIndex="{Binding PreferenceIndex}" Margin="0,0,0,8"/>
            <ComboBox materialDesign:HintAssist.Hint="关注重点" ItemsSource="{Binding Focuses}" SelectedIndex="{Binding FocusIndex}" Margin="0,0,0,12"/>
            <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
