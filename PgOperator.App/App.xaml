<Application x:Class="PgOperator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PgOperator.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue"
                                             SecondaryColor="Teal" />
                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToStatusIconConverter x:Key="BoolToStatusIconConverter" />
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter" />
            <converters:BoolToZeroVisibilityConverter x:Key="BoolToZeroVisibilityConverter" />
            <converters:BoolToBackupTypeConverter x:Key="BoolToBackupTypeConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <!-- [REVIEW-FIX] 诊断界面可见性转换器 -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:StatusTextToColorConverter x:Key="StatusTextToColorConverter" />
            <!-- [REVIEW-FIX] 诊断 Severity 相关转换器 -->
            <converters:SeverityToColorConverter x:Key="SeverityToColorConverter" />
            <converters:SeverityToLabelConverter x:Key="SeverityToLabelConverter" />
            <converters:SeverityToDetailVisibilityConverter x:Key="SeverityToDetailVisibilityConverter" />
            <converters:SeverityToBackgroundConverter x:Key="SeverityToBackgroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
